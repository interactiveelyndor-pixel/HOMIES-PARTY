PORT=3000
# Optional: 16+ chars enables the /admin moderation API (header x-admin-token)
# ADMIN_TOKEN=
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/homies_party
# Seconds a Quick Match search waits for another player (milliseconds)
# MATCH_TIMEOUT_MS=60000

# Quick Match (stranger pairing) ships OFF. Set true to enable, or flip at runtime via /admin/flags.
# FEATURE_PUBLIC_DISCOVERY=false
# Oldest app version the server accepts (shown to the app via /v1/config)
# MIN_CLIENT_VERSION=0.0.0
# Milliseconds before a disconnected player forfeits, background sweep interval, lobby lifetime
# DISCONNECT_GRACE_MS=90000
# SWEEP_MS=5000
# ROOM_EXPIRY_MINUTES=45
# DISABLE_SWEEPER=false
